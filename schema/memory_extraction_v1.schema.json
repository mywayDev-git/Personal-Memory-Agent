{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Memory Agent Extraction Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_context",
    "memories",
    "entities",
    "entity_links",
    "relations",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "reference_time",
        "language"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "reference_time": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "const": "ko"
        }
      }
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_id",
          "memory_type",
          "content",
          "subject",
          "predicate",
          "object",
          "target",
          "time",
          "polarity",
          "confidence",
          "evidence"
        ],
        "properties": {
          "local_id": {
            "type": "string",
            "pattern": "^m[1-9][0-9]*$"
          },
          "memory_type": {
            "enum": [
              "profile",
              "fact",
              "event",
              "preference",
              "plan",
              "decision",
              "experience",
              "other"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "$ref": "#/$defs/value_ref"
          },
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "object": {
            "$ref": "#/$defs/value_ref"
          },
          "target": {
            "anyOf": [
              {
                "$ref": "#/$defs/value_ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "time": {
            "$ref": "#/$defs/time"
          },
          "polarity": {
            "enum": [
              "positive",
              "negative",
              "uncertain"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quote"
              ],
              "properties": {
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_id",
          "entity_type",
          "canonical_name",
          "aliases",
          "match"
        ],
        "properties": {
          "local_id": {
            "type": "string",
            "pattern": "^e[1-9][0-9]*$"
          },
          "entity_type": {
            "enum": [
              "person",
              "place",
              "product",
              "organization",
              "event",
              "concept",
              "other"
            ]
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "decision"
            ],
            "properties": {
              "candidate_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "decision": {
                "enum": [
                  "matched",
                  "new",
                  "unresolved"
                ]
              }
            }
          }
        }
      }
    },
    "entity_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memory_ref",
          "entity_ref",
          "role"
        ],
        "properties": {
          "memory_ref": {
            "type": "string"
          },
          "entity_ref": {
            "type": "string"
          },
          "role": {
            "enum": [
              "subject",
              "object",
              "target",
              "participant",
              "location",
              "mentioned"
            ]
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "target_ref",
          "relation_category",
          "relation_type",
          "confidence",
          "evidence"
        ],
        "properties": {
          "source_ref": {
            "type": "string"
          },
          "target_ref": {
            "type": "string"
          },
          "relation_category": {
            "enum": [
              "semantic",
              "temporal"
            ]
          },
          "relation_type": {
            "enum": [
              "related_to",
              "caused_by",
              "supports",
              "contradicts",
              "supersedes",
              "before",
              "after",
              "overlaps",
              "during"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "value_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "value",
        "value_type"
      ],
      "properties": {
        "kind": {
          "enum": [
            "entity",
            "self",
            "unknown",
            "literal"
          ]
        },
        "ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "value_type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "date",
            "datetime",
            "none"
          ]
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "start",
        "end",
        "precision",
        "certainty"
      ],
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "day",
            "month",
            "year",
            "range",
            "relative",
            "unknown"
          ]
        },
        "certainty": {
          "enum": [
            "explicit",
            "inferred",
            "uncertain"
          ]
        }
      }
    }
  }
}