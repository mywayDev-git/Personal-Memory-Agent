{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_extraction_output.schema.json",
  "title": "Memory Extraction Output Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["memories"],
  "properties": {
    "memories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memory"
      }
    }
  },
  "$defs": {
    "value_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "value_type"],
      "properties": {
        "kind": {
          "enum": ["self", "entity", "literal", "unknown"]
        },
        "value": {
          "type": ["string", "number", "boolean", "null"]
        },
        "value_type": {
          "enum": [
            "string", "number", "boolean",
            "date", "datetime", "none"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {"const": "number"}
            },
            "required": ["value_type"]
          },
          "then": {
            "properties": {
              "value": {"type": "number"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {"const": "boolean"}
            },
            "required": ["value_type"]
          },
          "then": {
            "properties": {
              "value": {"type": "boolean"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "enum": ["string", "date", "datetime"]
              }
            },
            "required": ["value_type"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {"const": "none"}
            },
            "required": ["value_type"]
          },
          "then": {
            "properties": {
              "value": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "unknown"}
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "value": {"type": "null"},
              "value_type": {"const": "none"}
            }
          }
        }
      ]
    },
    "normalized_time": {
      "type": ["string", "null"],
      "anyOf": [
        {"type": "null"},
        {
          "type": "string",
          "pattern": "^\\d{4}$"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw", "start", "end", "precision", "certainty"
      ],
      "properties": {
        "raw": {
          "type": ["string", "null"]
        },
        "start": {
          "$ref": "#/$defs/normalized_time"
        },
        "end": {
          "$ref": "#/$defs/normalized_time"
        },
        "precision": {
          "enum": [
            "exact", "day", "month", "year",
            "range", "relative", "unknown"
          ]
        },
        "certainty": {
          "enum": ["explicit", "inferred", "uncertain"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {"const": "unknown"}
            },
            "required": ["precision"]
          },
          "then": {
            "properties": {
              "start": {"type": "null"},
              "end": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {"const": "relative"}
            },
            "required": ["precision"]
          },
          "then": {
            "properties": {
              "start": {"type": "null"},
              "end": {"type": "null"}
            }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "predicate", "object"],
          "properties": {
            "subject": {"$ref": "#/$defs/value_ref"},
            "predicate": {
              "type": "string",
              "minLength": 1
            },
            "object": {"$ref": "#/$defs/value_ref"}
          }
        }
      ]
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote"],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_type", "content", "subject",
        "predicate", "object", "target", "time",
        "assertion_polarity", "polarity",
        "content_certainty", "evidence"
      ],
      "properties": {
        "memory_type": {
          "enum": [
            "profile", "fact", "event", "preference",
            "plan", "decision", "experience", "other"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "#/$defs/value_ref"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "$ref": "#/$defs/value_ref"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "assertion_polarity": {
          "enum": ["affirmed", "negated", "uncertain"]
        },
        "polarity": {
          "enum": ["positive", "negative", "neutral", "uncertain"]
        },
        "content_certainty": {
          "enum": ["explicit", "inferred", "uncertain"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_item"}
        }
      }
    }
  }
}
