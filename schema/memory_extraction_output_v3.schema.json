{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-memory-agent.local/schema/memory_extraction_output_v3.schema.json",
  "title": "Memory Extraction Output Schema v3.0",
  "description": "Schema for the raw JSON output produced by the memory extraction LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memories"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "memories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memory"
      },
      "description": "Extracted memory units. Empty arrays are allowed when no useful memory is found."
    }
  },
  "$defs": {
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_type",
        "content",
        "subject",
        "predicate",
        "object",
        "target",
        "time",
        "polarity",
        "evidence"
      ],
      "properties": {
        "memory_type": {
          "type": "string",
          "enum": [
            "profile",
            "fact",
            "event",
            "preference",
            "plan",
            "decision",
            "experience",
            "other"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "#/$defs/value_ref"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "$ref": "#/$defs/value_ref"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/value_ref"
            },
            {
              "$ref": "#/$defs/relation"
            },
            {
              "type": "null"
            }
          ]
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "polarity": {
          "type": "string",
          "enum": [
            "positive",
            "negative",
            "neutral",
            "uncertain"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "#/$defs/value_ref"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "$ref": "#/$defs/value_ref"
        }
      },
      "required": [
        "subject",
        "predicate",
        "object"
      ],
      "additionalProperties": false
    },
    "value_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "value_type"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "self",
            "entity",
            "literal",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "value_type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "date",
            "datetime",
            "none"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unknown"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "value_type": {
                "const": "none"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "self"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "value_type": {
                "const": "string"
              }
            }
          }
        }
      ]
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "start",
        "end",
        "precision",
        "certainty"
      ],
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "precision": {
          "type": "string",
          "enum": [
            "exact",
            "day",
            "month",
            "year",
            "range",
            "relative",
            "unknown"
          ]
        },
        "certainty": {
          "type": "string",
          "enum": [
            "explicit",
            "inferred",
            "uncertain"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "const": "unknown"
              }
            },
            "required": [
              "precision"
            ]
          },
          "then": {
            "properties": {
              "start": {
                "type": "null"
              },
              "end": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote"
      ],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
